{
  "name": "pressmark-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate": "buf generate",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage.enabled",
    "typecheck": "tsc -b",
    "prepare": "cd ../.. && npx husky src/pressmark-web/.husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@connectrpc/connect": "^2.3.0",
    "@connectrpc/connect-web": "^2.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "i18next": "^26.7.1",
    "lucide-react": "^1.68.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-i18next": "^17.1.12",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "~8.2.4",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "!(src/api/generated/**)*.{ts,tsx}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{js,json,css,md}": "prettier --write"
  },
  "overrides": {
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.8",
    "minimatch": "^11.0.4",
    "nanoid": "^3.3.17"
  }
}
